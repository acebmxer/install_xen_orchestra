#!/usr/bin/expect -f
#
# xo-proxy-helper.exp — automated XO Proxy installer
#
# Called by install-xen-orchestra.sh when the user selects "Install XO Proxy".
# Arguments (positional):
#   $argv 0  pool_master   IP/hostname of the Xen pool master
#   $argv 1  username      SSH username for the pool master
#   $argv 2  proxy_ip      Desired proxy IP address, or "dhcp"
#   $argv 3  ntp_server    NTP server address (empty string = use default)
#   $argv 4  xo_username   Xen Orchestra web UI username (email)
#
# Passwords are NOT passed as arguments: a process's command line is
# world-readable (ps, /proc/<pid>/cmdline) for as long as it runs, while its
# environment is not. The caller sets these instead:
#   XO_HELPER_HOST_PASSWORD   SSH password for the pool master
#   XO_HELPER_XO_PASSWORD     Xen Orchestra web UI password
# and, optionally (not a secret, kept here beside the others):
#   XO_HELPER_KNOWN_HOSTS     known_hosts file with the checked pool master key
#
# Outputs lines of the form:
#   CAPTURED_VALUES:
#   PROXY_IP=<ip>
#   PROXY_UUID=<uuid>
#   AUTH_TOKEN=<token>
# which install-xen-orchestra.sh parses after the script exits.

set timeout 600
set pool_master [lindex $argv 0]
set username    [lindex $argv 1]
set proxy_ip    [lindex $argv 2]
set ntp_server  [lindex $argv 3]
set xo_username [lindex $argv 4]
set password    $env(XO_HELPER_HOST_PASSWORD)
set xo_password $env(XO_HELPER_XO_PASSWORD)

# Variables to capture output
set proxy_uuid      ""
set auth_token      ""
set actual_proxy_ip ""

log_user 1

# Connect to pool master.
#
# XO_HELPER_KNOWN_HOSTS, when set, is the run-scoped known_hosts holding the
# pool master key install-xen-orchestra.sh checked before sending the
# password (deploy_verify_host_key). The connection is held to that key alone.
# Without it (the key was already in the operator's own known_hosts, which ssh
# enforces), accept-new as before.
set known_hosts ""
if {[info exists env(XO_HELPER_KNOWN_HOSTS)]} {
    set known_hosts $env(XO_HELPER_KNOWN_HOSTS)
}
if {$known_hosts ne "" && [file exists $known_hosts] && [file size $known_hosts] > 0} {
    spawn ssh -o UserKnownHostsFile=$known_hosts -o StrictHostKeyChecking=yes $username@$pool_master
} else {
    spawn ssh -o StrictHostKeyChecking=accept-new $username@$pool_master
}

# A shell prompt: "# " for root, "$ " for anyone else, at the end of what
# has arrived so far.
set shell_prompt {[#$] $}

# Handle the password prompt -- or no prompt at all: with a key or an agent
# the pool master goes straight to the shell, and waiting only for
# "password:" sat out the whole 600 s timeout before carrying on.
set at_prompt 0
expect {
    "password:" {
        send "$password\r"
    }
    -re $shell_prompt {
        set at_prompt 1
    }
}

# Wait for shell prompt and run installer.
#
# Saved to a file on the pool master first, rather than piped straight into
# bash, so there is a copy on disk to inspect if this ever needs auditing --
# same reasoning as the NodeSource setup script in install-xen-orchestra.sh.
# This is still Vates' own documented one-liner with no signature or
# checksum to verify it against; running it unattended trusts xoa.io and the
# network path to it, same as running it by hand would.
#
# A prompt already matched above has been consumed, so waiting for another
# here would hang: send the command straight away in that case.
if {!$at_prompt} {
    expect -re $shell_prompt
}
send "wget -qO /tmp/xo-proxy-deploy.sh https://xoa.io/proxy/deploy && bash /tmp/xo-proxy-deploy.sh; rm -f /tmp/xo-proxy-deploy.sh\r"

# The installer goes quiet while it downloads and imports the 1.2 GB
# appliance, and on a slow link that takes longer than the 600 s above
# (19 minutes has been seen). A timeout there stopped the helper reading
# before the IP, UUID and token were printed, so none were captured. Allow
# an hour of silence here; XO_HELPER_INSTALL_TIMEOUT (seconds) overrides it.
set install_timeout 3600
if {[info exists env(XO_HELPER_INSTALL_TIMEOUT)] &&
    [string is digit -strict $env(XO_HELPER_INSTALL_TIMEOUT)]} {
    set install_timeout $env(XO_HELPER_INSTALL_TIMEOUT)
}
set timeout $install_timeout

# Handle installer prompts
expect {
    -re "IP address\\? \\\[dhcp\\\]" {
        if {$proxy_ip eq "dhcp" || $proxy_ip eq "DHCP"} {
            send "\r"
        } else {
            send "$proxy_ip\r"
        }
        exp_continue
    }
    -re "Custom NTP servers.*\\? \\\[\\\]" {
        if {$ntp_server eq ""} {
            send "\r"
        } else {
            send "$ntp_server\r"
        }
        exp_continue
    }
    -re "Xen Orchestra \\(XO\\) address\\?" {
        send "http://localhost\r"
        exp_continue
    }
    -re "Your Xen Orchestra account \\(email\\)\\?" {
        send "$xo_username\r"
        exp_continue
    }
    -re "Your Xen Orchestra account password\\?" {
        send "$xo_password\r"
        exp_continue
    }
    -re "XO Proxy Appliance IP address( is)?:\\s+(\[0-9.\]+)\r?\n" {
        set actual_proxy_ip $expect_out(2,string)
        exp_continue
    }
    -re "UUID: (\[a-f0-9-\]+)" {
        set proxy_uuid $expect_out(1,string)
        exp_continue
    }
    -re "authentication token: (\[a-zA-Z0-9_-\]+)" {
        set auth_token $expect_out(1,string)
        exp_continue
    }
    -re "token: (\[a-zA-Z0-9_-\]+)" {
        set auth_token $expect_out(1,string)
        exp_continue
    }
    -re ".*#" {
        # Back at prompt — installation complete
    }
    timeout {
        send_user "\nTimeout waiting for installer\n"
    }
    eof {
    }
}

# Exit SSH session
send "exit\r"
expect eof

# Output captured values
puts "\nCAPTURED_VALUES:"
puts "PROXY_IP=$actual_proxy_ip"
puts "PROXY_UUID=$proxy_uuid"
puts "AUTH_TOKEN=$auth_token"
