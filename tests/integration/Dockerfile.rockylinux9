FROM rockylinux:9
# EPEL straight from Fedora's own server, not a random mirror from the
# metalink: a mirror with a broken certificate (mirrors.wcupa.edu) failed
# image builds at random. Only the [epel] section is changed.
RUN dnf install -y epel-release \
    && sed -i -e '/^\[epel\]/,/^\[/{s|^#baseurl=https://download.example/pub/|baseurl=https://dl.fedoraproject.org/pub/|;s|^metalink=|#metalink=|}' \
       /etc/yum.repos.d/epel.repo \
    && dnf install -y sudo git bash bats ShellCheck ca-certificates \
    openssl xorriso openssh-clients diffutils python3-pyyaml \
    && dnf clean all \
    && ln -s /usr/bin/ShellCheck /usr/local/bin/shellcheck

# Create non-root user with passwordless sudo
RUN useradd -m -s /bin/bash tester \
    && echo "tester ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER tester
WORKDIR /home/tester

COPY --chown=tester:tester . /home/tester/install-xen-orchestra/

WORKDIR /home/tester/install-xen-orchestra

CMD ["bats", "tests/integration/test_install_smoke.bats"]
