# DEPRECATED — scheduled for deletion on 2026-10-01.
#
# Debian 11 (Bullseye) reached end-of-life on 2026-08-31 and receives no
# further security updates. This image and its CI matrix entry in
# .github/workflows/ci.yml are kept only so the deprecation window stays
# tested; delete both on the removal date.
FROM debian:11
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo git curl bash bats shellcheck ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user with passwordless sudo (mirrors real install usage)
RUN useradd -m -s /bin/bash tester \
    && echo "tester ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER tester
WORKDIR /home/tester

COPY --chown=tester:tester . /home/tester/install-xen-orchestra/

WORKDIR /home/tester/install-xen-orchestra

CMD ["bats", "tests/integration/test_install_smoke.bats"]
